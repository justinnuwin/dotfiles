# fzf ** completion lists the immediate directory first, then streams in
# everything below it.
if (( $+commands[fd] )); then
    # Arg 1: Directory to search
    # Remaining args: Extra fd options
    fzf_fd_shallow_first() {
        local root="$1"
        shift
        fd --hidden --follow --exclude .git --exclude node_modules --max-depth 1 "$@" . "$root"
        fd --hidden --follow --exclude .git --exclude node_modules --min-depth 2 "$@" . "$root"
    }
    _fzf_compgen_path() { fzf_fd_shallow_first "$1" }
    _fzf_compgen_dir() { fzf_fd_shallow_first "$1" --type d }
fi

# ssh host completion, with and without **, lists ~/.ssh/config hosts in file
# order, then the destinations of ssh commands in history, most recent first.
__fzf_list_hosts() {
    local -aU hosts
    local -a words
    local line
    local -i i
    for line in ${(f)"$(command cat ~/.ssh/config ~/.ssh/config.d/*(N) 2>/dev/null)"}; do
        words=(${=line%%\#*})
        [[ ${(L)words[1]} == host ]] && hosts+=(${words[2,-1]:#*[*?%!]*})
    done
    for line in ${(f)"$(fc -lnr 1)"}; do
        words=(${(z)line})
        [[ $words[1] == ssh ]] || continue
        for (( i = 2; i <= $#words; i++ )); do
            case $words[i] in
                # Options that take the next word as their argument
                -[BbcDEeFIiJLlmOoPpQRSWw]) (( i++ )) ;;
                -*) ;;
                *)
                    hosts+=(${${${(Q)words[i]}#ssh://}#*@})
                    break
                    ;;
            esac
        done
    done
    print -rl -- $hosts
}
zstyle -e ':completion:*:(ssh|scp|sftp):*' hosts 'reply=(${(f)"$(__fzf_list_hosts)"})'
# Local accounts are offered as login names otherwise.
zstyle ':completion:*:(ssh|scp|sftp):*' users
zstyle ':completion:*:(ssh|scp|sftp):*' sort false

# bazel **<Tab> (and brun/bbuild/btest **<Tab>) fuzzy-picks from the targets
# named in the BUILD files of the current workspace, as //pkg:name. run and test
# only list *_binary/*_test and *_test/test_suite rules, the same split as
# bazel's own completion. Targets generated by macros are not listed.

# Arg 1: Optional extended regex of rule kinds to keep. Without it every named
#   target is listed; with it only rules whose call starts with name = "..."
#   are seen, since the kind is read from the line before the name.
__fzf_list_bazel_targets() {
    local kind_re="$1"
    local root
    root="$(get_bazel_root)" || return
    if [[ -z "$kind_re" ]]; then
        rg --no-heading --with-filename --only-matching --replace '$1' \
            '^\s*name\s*=\s*"([^"]+)"' -g BUILD -g BUILD.bazel "$root" 2>/dev/null
    else
        rg -U --no-heading --with-filename --only-matching --replace '$1 $2' \
            '(?m)^([A-Za-z_][\w.]*)\(\s*name\s*=\s*"([^"]+)"' -g BUILD -g BUILD.bazel "$root" 2>/dev/null |
            sed -nE "s#^([^:]*):(${kind_re}) #\1:#p"
    fi | sed -E "s#^${root}/##; s#(^|/)BUILD(\.bazel)?:#:#; s#^#//#"
}

# Arg 1: The command line left of the cursor.
_fzf_complete_bazel() {
    local -a tokens
    tokens=(${(z)1})
    local subcommand token
    case $tokens[1] in
        bbuild) subcommand=build ;;
        btest) subcommand=test ;;
        brun) subcommand=run ;;
        *)
            for token in $tokens[2,-1]; do
                [[ $token == -* ]] && continue
                subcommand=$token
                break
            done
            ;;
    esac
    local kind_re=
    case $subcommand in
        test | coverage) kind_re='[A-Za-z_.]*_test|test_suite' ;;
        run) kind_re='[A-Za-z_.]*_(binary|test)' ;;
    esac
    _fzf_complete --multi --prompt="target> " -- "$@" < <(__fzf_list_bazel_targets "$kind_re")
}
_fzf_complete_brun() { _fzf_complete_bazel "$@" }
_fzf_complete_bbuild() { _fzf_complete_bazel "$@" }
_fzf_complete_btest() { _fzf_complete_bazel "$@" }
