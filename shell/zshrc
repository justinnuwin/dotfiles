# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

# Show indicator when completion task is running
zmodload zsh/terminfo

# Set locale
export LANG="en_US.UTF-8"

# Set preferred terminal
if [[ -z "$TERM" ]]; then
  if infocmp xterm-256color-italic >/dev/null 2>&1; then
    export TERM="xterm-256color-italic"
  elif infocmp xterm-256color >/dev/null 2>&1; then
    export TERM="xterm-256color"
  fi
fi

# Configure shell history
HISTFILE="$HOME/.zsh_history"
HISTSIZE=70000
SAVEHIST=50000

# History options
setopt APPEND_HISTORY          # Append to history file rather than replace it
setopt INC_APPEND_HISTORY      # Write to the history file immediately, not when logging out
                               # Do NOT dynamically read in the history
setopt HIST_IGNORE_DUPS        # Do not record an event that is a duplicate of the previous one
setopt HIST_EXPIRE_DUPS_FIRST  # After history is full, evict duplicates first
setopt HIST_REDUCE_BLANKS      # Remove extra blanks from each command line before adding it
setopt HIST_VERIFY             # Don't execute immediately when using history expansion (e.g. !!)
setopt EXTENDED_HISTORY        # Save start times of commands in history
setopt HIST_IGNORE_SPACE       # Do not record commands that start with a space
setopt HIST_FIND_NO_DUPS       # Show each match only once when searching history

# Additional options
setopt EXTENDED_GLOB         # Enable ^, ~, # and (#flags) glob operators
setopt GLOB_DOTS             # Match dotfiles without an explicit leading .
setopt NUMERIC_GLOB_SORT     # Sort numbered glob matches numerically
setopt NOTIFY                # Report background job status immediately
setopt LONG_LIST_JOBS        # Show process IDs in job notifications
setopt INTERACTIVE_COMMENTS  # Allow # comments at the interactive prompt
setopt CORRECT               # Offer corrections for mistyped commands
setopt COMPLETE_IN_WORD      # Complete from the cursor position within a word
setopt ALWAYS_TO_END         # Move the cursor to the end of a word after completing it
setopt NO_FLOW_CONTROL       # Free Ctrl-S and Ctrl-Q from pausing terminal output

# Unset options
unsetopt AUTO_CD BEEP NOMATCH

# Vim mode
bindkey -v

# Bash-like reverse search
bindkey '^R' history-incremental-search-backward

# Set path to .dotfiles
local dotfiles="$HOME/.dotfiles"

# Zsh completion
zstyle :compinstall filename '/home/justin/.zshrc'
bindkey '\t' menu-complete
# Let slow completion functions (e.g. bazel's) cache their results
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path ~/.zsh/cache
# Place completion cache in a directory rather than the default $HOME
mkdir -p ~/.cache/zsh
export ZSH_COMPDUMP="$HOME/.cache/zsh/zcompdump"
autoload -Uz compinit
fpath=("$dotfiles/shell/zsh_completions" $fpath)
# Check cache age <24hrs, skip security checks if it's fresh
local -a old_dump=( "$ZSH_COMPDUMP"(N.mh+24) )
if (( $#old_dump )); then
  compinit -d "$ZSH_COMPDUMP"
  touch -m "$ZSH_COMPDUMP"
else
  compinit -C -d "$ZSH_COMPDUMP"
fi

function set_completion_indicator {
  echoti sc # save_cursor
  echoti cup $((LINES - 1)) $((COLUMNS - $#1)) # cursor_position
  echoti setaf $2 # set_foreground (color)
  printf %s $1
  echoti sgr 0 # exit_attribute_mode
  echoti rc # restore_cursor
}

completion_indicator_text='(completing)'
completion_indicator_color=3
function display_completion_indicator {
  compprefuncs+=(display_completion_indicator)
  set_completion_indicator $completion_indicator_text $completion_indicator_color
}

function hide_completion_indicator {
  comppostfuncs+=(hide_completion_indicator)
  # The completion code erases the indicator, so there's nothing to do.
}

compprefuncs+=(display_completion_indicator)
comppostfuncs+=(hide_completion_indicator)

# Set custom dircolors
if which dircolors >/dev/null 2>&1
then
  eval "$(dircolors "$dotfiles"/shell/dircolors)"
fi

# Prompt theme is selected by JNSHELL_PROMPT in ~/.localshell and loaded by
# shell/modules/prompt.sh (sourced via jnshell_interactive_setup below).

# Enable fuzzy command history and file search
fzf_zsh_path="$dotfiles/shell/zsh_plugins/fzf-zsh-plugin"
if [[ -d "$fzf_zsh_path" ]]; then
    source "$fzf_zsh_path/fzf-zsh-plugin.plugin.zsh"
fi

# Sourced after fzf-zsh-plugin to replace its completion functions
source "$dotfiles/shell/fzf_completions.zsh"

# Enable fuzzy tab completion
fzf_tab="$dotfiles/shell/zsh_plugins/fzf-tab/fzf-tab.plugin.zsh"
if [[ -f "$fzf_tab" ]]; then
    source "$fzf_tab"
fi

# Common shell aliases and functions (justinShell.sh is sourced by ~/.zshenv)
jnshell_interactive_setup

# Add some spice and delight to the shell
source "$dotfiles/shell/fun.sh"
